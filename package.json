{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:content": "node scripts/check-content.mjs",
    "prebuild": "node scripts/check-content.mjs && node scripts/write-ads-txt.mjs",
    "postbuild": "node scripts/clean-export.mjs",
    "predeploy": "npm run build",
    "deploy": "touch out/.nojekyll && echo 'rajib.uk' > out/CNAME && gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "gh-pages": "^6.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
