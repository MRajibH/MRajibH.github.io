# AdSense is off until NEXT_PUBLIC_ADSENSE_CLIENT is set. Leave everything
# empty until the AdSense account exists. On Cloudflare Pages, set these as
# build environment variables instead of committing a .env file.
#
# In the AdSense dashboard keep "Auto ads" OFF for this site, otherwise Google
# places ads on pages (home, about, contact) that must stay ad-free.

# Publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad unit ids (create one display unit per position). A slot left empty is not rendered.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_INDEX=
